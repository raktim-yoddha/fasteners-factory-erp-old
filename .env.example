# Supabase Dashboard → Connect. These public values are safe for the browser; RLS protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local automated E2E only. Keep values in ignored .env.e2e.local, never commit them.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_ALLOW_SAMPLE_WRITES=
# Optional hosted SQL runner: isolated project ref plus SUPABASE_ACCESS_TOKEN in the runner environment.
E2E_DATABASE_PROJECT_REF=
