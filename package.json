{
  "name": "fasteners-factory-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm e2e",
    "test:factory": "node scripts/test-factory.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:restore": "node scripts/test-restore.mjs",
    "e2e:seed": "node scripts/seed-e2e.mjs",
    "e2e:stack": "supabase start --exclude realtime,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "release": "node scripts/release.mjs",
    "backup:create": "node scripts/create-backup.mjs",
    "check:operations": "node scripts/check-operations.mjs",
    "test:devices": "playwright test tests/e2e/device-acceptance.spec.ts",
    "backup:verify": "node scripts/read-backup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.3.3"
  }
}
